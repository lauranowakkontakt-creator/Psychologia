# Konfiguracja wersji z logowaniem (`npm run build:firebase`).
# Skopiuj ten plik jako `.env.firebase` i wpisz wartości z konsoli Firebase:
# Ustawienia projektu -> Ogólne -> Twoje aplikacje -> aplikacja internetowa -> Konfiguracja.
# To nie są hasła (trafiają do strony i tak), ale pliku `.env.firebase` nie commitujemy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=psycho-xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=psycho-xxxxx
VITE_FIREBASE_APP_ID=
