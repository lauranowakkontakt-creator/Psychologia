{
  "name": "psycho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src test e2e e2e-logowanie scripts",
    "test": "node --test test/*.test.js",
    "check": "npm run clean:mac && npm run lint && npm test && npm run test:bez-notatek && npm run test:e2e && npm run test:e2e:logowanie",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks || true",
    "clean:mac": "dot_clean -m . 2>/dev/null || true",
    "build:firebase": "vite build --mode firebase",
    "deploy:firebase": "npm run check && npm run build:firebase && npx --yes firebase-tools deploy --only hosting,firestore:rules",
    "wyslij-notatki": "node scripts/wyslij-notatki.mjs",
    "test:bez-notatek": "node scripts/sprawdz-paczke.mjs",
    "test:e2e:logowanie": "playwright test -c playwright.logowanie.config.js",
    "widget": "node scripts/widget.mjs",
    "publikuj-kod": "node scripts/publikuj-kod.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "firebase": "^13.1.0",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.5.0",
    "globals": "^17.13.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "workbox-window": "^7.4.1"
  }
}
